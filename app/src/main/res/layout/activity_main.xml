<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fillViewport="true" android:background="#F4F6F8"><LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="Контроль расходов" android:textSize="31sp" android:textStyle="bold" android:textColor="#172033" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/monthTotal" android:text="Расходы за месяц: 0,00 ₽" android:textSize="22sp" android:textStyle="bold" android:textColor="#0B6E4F" android:background="#E6F4EE" android:padding="14dp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/status" android:text="Добавьте чек камерой или из галереи" android:textSize="16sp" android:textColor="#657084" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><LinearLayout android:orientation="horizontal" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/scanButton" android:text="📷 Камера" android:layout_weight="1" android:layout_width="0dp" android:layout_height="56dp"/><Button android:id="@+id/galleryButton" android:text="🖼 Галерея" android:layout_weight="1" android:layout_marginStart="10dp" android:layout_width="0dp" android:layout_height="56dp"/></LinearLayout><Button android:id="@+id/manualButton" android:text="➕ Добавить расход без чека" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="52dp"/><TextView android:text="ОКНО ФОРМИРОВАНИЯ ЧЕКА" android:textStyle="bold" android:textColor="#657084" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/dateEdit" android:hint="Дата покупки" android:inputType="date" android:sin